# Python 실행에서는 자동으로 읽지 않습니다. README의 export 명령을 사용하세요.
# Docker Compose는 .env를 읽습니다.
API_KEYS={"replace-with-a-random-token-at-least-32-characters":"maker-01"}
AI_PROVIDER=openai
# 서버 전용 OpenAI API 키. 저장소에 실제 키를 커밋하지 마세요.
OPENAI_API_KEY=
# 계정에서 사용할 수 있는 Responses API + Structured Outputs 지원 GPT 모델 ID
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=16384
# 영상 실행/가용성 조회에만 필요. 시나리오 계획 생성은 이 키 없이도 가능합니다.
COMFY_CLOUD_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
