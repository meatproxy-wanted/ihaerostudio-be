# Python 실행에서는 자동으로 읽지 않습니다. README의 .env 로딩 명령을 사용하세요.
# Docker Compose는 .env를 읽습니다.
# anonymous(기본): 브라우저가 만든 방문자 ID처럼 16자 이상의 아무 토큰이나 자기 작업함이 됩니다(공개 체험용).
# keys: 아래 API_KEYS에 등록한 토큰만 통과합니다.
AUTH_MODE=anonymous
# 등록 토큰 → 제작자 ID. 익명 모드에서는 선택 사항이고, keys 모드에서는 필수입니다.
API_KEYS='{"replace-with-a-random-token-at-least-32-characters":"maker-01"}'
AI_PROVIDER=openai
# 서버 전용 OpenAI API 키. 저장소에 실제 키를 커밋하지 마세요.
OPENAI_API_KEY=
# 계정에서 사용할 수 있는 Responses API + Structured Outputs 지원 GPT 모델 ID
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=16384
# FE 그림 후보 보기에서 실제 Comfy Cloud 그림을 생성할 때 사용합니다.
COMFY_CLOUD_API_KEY=
# library(기본): AI가 고정 10종에서 선택. generate: 기존 Qwen 초상 생성(새 자료 기준).
STUDIO_CHARACTER_MODE=library
# Cloud 결과 이미지 다운로드를 허용할 정확한 호스트. 운영자가 확인한 CDN 호스트만 쉼표로 추가.
# 와일드카드·IP·localhost는 사용하지 마세요. 실제 계정의 서명 URL 호스트는 실행 후 확인 필요.
COMFY_ASSET_ALLOWED_HOSTS=cloud.comfy.org,storage.googleapis.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 자료 저장소. 비우면 DATABASE_PATH의 SQLite 파일(기본 data/studio.sqlite3)을 씁니다.
# Vercel처럼 디스크가 유지되지 않는 곳에서는 Turso 주소와 토큰을 넣습니다(Marketplace 연동이 자동으로 채워 줍니다).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 그림 주소를 만들 때 쓰는 이 서버의 공개 주소. 비우면 Vercel 프로젝트 주소, 로컬에서는 http://127.0.0.1:8100.
# 그림 URL에 그대로 저장되므로 자료를 만들기 전에 정합니다.
PUBLIC_BASE_URL=
